# Bajo Tigui — variables de entorno (Fase 4)
# Copiar a .env.local y completar. NUNCA subir .env* a git.

# Base de datos (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Turnstile (formularios públicos)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Pagos — Wompi (principal)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
# Pagos — ePayco (respaldo)
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=

# WhatsApp Cloud API (Meta)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# Correo (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=contacto@bajotigui.co

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000